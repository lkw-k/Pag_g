# Copy this file to .env and fill in your values.

# Ollama server - https://ollama.com/
OLLAMA_HOST=http://localhost:11434

# Local Ollama model used to generate answers
RAG_MODEL=llama3.1

# Where the Chroma vector store is persisted
CHROMA_DIR=.chroma

# Retrieval settings
RAG_TOP_K=4
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
